<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/share_title"
            android:textColor="#111827"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/version_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#6B7280"
            android:textSize="13sp" />

        <Button
            android:id="@+id/select_photos_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/select_photos" />

        <TextView
            android:id="@+id/selected_count_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="#374151"
            android:textSize="16sp"
            android:text="@string/selected_count" />

        <TextView
            android:id="@+id/preset_label_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textColor="#111827"
            android:textSize="16sp"
            android:textStyle="bold"
            android:text="@string/preset_label" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/layout_mode"
            android:textColor="#374151"
            android:textSize="14sp" />

        <RadioGroup
            android:id="@+id/layout_mode_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/mode_grid_radio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/mode_grid" />

            <RadioButton
                android:id="@+id/mode_single_radio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/mode_single" />
        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/fit_mode"
            android:textColor="#374151"
            android:textSize="14sp" />

        <RadioGroup
            android:id="@+id/fit_mode_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/fit_contain_radio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/fit_contain" />

            <RadioButton
                android:id="@+id/fit_cover_radio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/fit_cover" />
        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/resolution_mode"
            android:textColor="#374151"
            android:textSize="14sp" />

        <RadioGroup
            android:id="@+id/resolution_mode_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/resolution_print_radio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/resolution_print" />

            <RadioButton
                android:id="@+id/resolution_original_radio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/resolution_original" />
        </RadioGroup>

        <Button
            android:id="@+id/print_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:enabled="false"
            android:text="@string/start_print" />
    </LinearLayout>
</ScrollView>
