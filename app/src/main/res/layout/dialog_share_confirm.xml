<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/share_title_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/share_title"
        android:textColor="#111827"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/share_count_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#374151"
        android:textSize="16sp"
        android:text="@string/loading_photos" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/layout_mode"
        android:textColor="#374151"
        android:textSize="14sp" />

    <RadioGroup
        android:id="@+id/share_mode_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/share_mode_grid_radio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/mode_grid" />

        <RadioButton
            android:id="@+id/share_mode_single_radio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/mode_single" />
    </RadioGroup>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/fit_mode"
        android:textColor="#374151"
        android:textSize="14sp" />

    <RadioGroup
        android:id="@+id/share_fit_mode_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/share_fit_contain_radio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/fit_contain" />

        <RadioButton
            android:id="@+id/share_fit_cover_radio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/fit_cover" />
    </RadioGroup>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/resolution_mode"
        android:textColor="#374151"
        android:textSize="14sp" />

    <RadioGroup
        android:id="@+id/share_resolution_mode_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/share_resolution_print_radio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/resolution_print" />

        <RadioButton
            android:id="@+id/share_resolution_original_radio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/resolution_original" />
    </RadioGroup>

    <Button
        android:id="@+id/share_confirm_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:enabled="false"
        android:text="@string/share_confirm" />

    <Button
        android:id="@+id/share_cancel_button"
        style="?android:attr/buttonBarButtonStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/cancel" />
</LinearLayout>
